# Copy to .env (never commit it). On the server, restrict .env to the service account:
#   icacls .env /inheritance:r /grant:r "%USERNAME%:R"
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SVC_DBT
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING_WH
SNOWFLAKE_DATABASE=ANALYTICS
# Key-pair auth (Snowflake is retiring password-only sign-in for service users).
SNOWFLAKE_PRIVATE_KEY_PATH=C:\secrets\snowflake\svc_dbt.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Dev target only: your personal schema prefix, e.g. DBT_JDOE
DBT_DEV_SCHEMA=DBT_DEV
DBT_THREADS=8

# Optional: POST a {"text": ...} message here when a run fails (Slack / Teams workflow webhook).
ALERT_WEBHOOK_URL=
